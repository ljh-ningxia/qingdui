# ---- 运行时数据（绝不入库）----
data/
*.db
*.db-shm
*.db-wal
*.db-journal

# ---- 日志 ----
*.log
server.log
start*.log

# ---- 上传文件 ----
uploads/

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example
# 本地开发自动生成的会话密钥（secrets.js 创建），绝不可入库
.qd-dev-secret
*.pem
*.key

# ---- 依赖与构建产物（本项目零依赖，仅作防御）----
node_modules/
# dist/ 例外：托管部署需要 dist/index.html（自包含前端）直接可用
dist/*
!dist/index.html
build/

# ---- 编辑器与系统 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.tmp
*.temp
*.bak
